{
  "name": "rglass",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benis-me/react-liquid-glass.git",
    "directory": "packages/react-liquid-glass"
  },
  "homepage": "https://react-liquid-glass-alpha.vercel.app/",
  "bugs": {
    "url": "https://github.com/benis-me/react-liquid-glass/issues"
  },
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "webgpu",
    "webgl",
    "components",
    "ios",
    "apple",
    "refraction"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./controls.css": {
      "types": "./dist/controls.css.d.ts",
      "default": "./dist/controls.css"
    },
    "./liquid-glass": {
      "types": "./dist/liquid-glass/index.d.ts",
      "import": "./dist/liquid-glass.js",
      "require": "./dist/liquid-glass.cjs"
    },
    "./liquid-glass/renderer": {
      "types": "./dist/liquid-glass/renderer.d.ts",
      "import": "./dist/liquid-glass-renderer.js",
      "require": "./dist/liquid-glass-renderer.cjs"
    },
    "./apple-motion": {
      "types": "./dist/apple-motion/index.d.ts",
      "import": "./dist/apple-motion.js",
      "require": "./dist/apple-motion.cjs"
    },
    "./apple-motion/react": {
      "types": "./dist/apple-motion/react.d.ts",
      "import": "./dist/apple-motion-react.js",
      "require": "./dist/apple-motion-react.cjs"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls.js",
      "require": "./dist/controls.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "description": "Liquid glass for React: WebGPU refraction with a WebGL2 fallback, fusing shapes and spring motion, in accessible components.",
  "scripts": {
    "build": "vite build --config vite.config.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.18"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69"
  }
}
